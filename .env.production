# Production Environment Variables for Render Deployment
APP_NAME="Lo Samajh Lo"
APP_ENV=production
APP_KEY=base64:7A1bZ... (Auto-generated by Render)
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://lo-samajh-lo.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=lsl_cache

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
